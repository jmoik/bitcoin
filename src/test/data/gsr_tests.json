    {
        "category": "OP_CAT tests",
        "tests": [
            {
                "name": "OP_CAT - basic concatenation",
                "initial stack": ["616263", "646566"],
                "opcodes": ["OP_CAT"],
                "success": true,
                "final stack": ["616263646566"],
                "varops cost": 6,
                "description": "COPYING: len(A) + len(B) = 3 + 3 = 6"
            },
            {
                "name": "OP_CAT with empty first operand",
                "initial stack": ["", "68656C6C6F"],
                "opcodes": ["OP_CAT"],
                "success": true,
                "final stack": ["68656C6C6F"],
                "varops cost": 5,
                "description": "COPYING: len(A) + len(B) = 0 + 5 = 5"
            },
            {
                "name": "OP_CAT with empty second operand",
                "initial stack": ["74657374", ""],
                "opcodes": ["OP_CAT"],
                "success": true,
                "final stack": ["74657374"],
                "varops cost": 4,
                "description": "COPYING: len(A) + len(B) = 4 + 0 = 4"
            },
            {
                "name": "OP_CAT with both operands empty",
                "initial stack": ["", ""],
                "opcodes": ["OP_CAT"],
                "success": true,
                "final stack": [""],
                "varops cost": 0,
                "description": "COPYING: len(A) + len(B) = 0 + 0 = 0"
            },
            {
                "name": "OP_CAT with binary data",
                "initial stack": ["0102", "030405"],
                "opcodes": ["OP_CAT"],
                "success": true,
                "final stack": ["0102030405"],
                "varops cost": 5,
                "description": "COPYING: len(A) + len(B) = 2 + 3 = 5"
            },
            {
                "name": "OP_CAT with single byte operands",
                "initial stack": ["FF", "00"],
                "opcodes": ["OP_CAT"],
                "success": true,
                "final stack": ["FF00"],
                "varops cost": 2,
                "description": "COPYING: len(A) + len(B) = 1 + 1 = 2"
            },
            {
                "name": "OP_CAT with insufficient stack elements should fail",
                "initial stack": ["616263"],
                "opcodes": ["OP_CAT"],
                "success": false
            },
            {
                "name": "OP_CAT with empty stack should fail",
                "initial stack": [],
                "opcodes": ["OP_CAT"],
                "success": false
            },
            {
                "name": "OP_CAT exceeding MAX_TAPSCRIPT_V2_STACK_ELEMENT_SIZE should fail",
                "initial stack": ["AA{2500000}", "BB{2500000}"],
                "opcodes": ["OP_CAT"],
                "success": false
            },
            {
                "name": "OP_CAT at the size limit should succeed",
                "initial stack": ["CC{2000000}", "DD{2000000}"],
                "opcodes": ["OP_CAT"],
                "success": true,
                "final stack": ["CC{2000000}DD{2000000}"],
                "varops cost": 4000000,
                "description": "COPYING: len(A) + len(B) = 2000000 + 2000000 = 4000000"
            }
        ]
    },
    {
        "category": "OP_SUBSTR tests",
        "tests": [
            {
                "name": "OP_SUBSTR - basic substring extraction",
                "initial stack": ["68656C6C6F", "01", "03"],
                "opcodes": ["OP_SUBSTR"],
                "success": true,
                "final stack": ["656C6C"],
                "varops cost": 5,
                "description": "LENGTHCONV + COPYING: len(BEGIN) + len(LEN) + min(3, 5-1) = 1 + 1 + 3 = 5"
            },
            {
                "name": "OP_SUBSTR - extract from beginning",
                "initial stack": ["74657374", "", "02"],
                "opcodes": ["OP_SUBSTR"],
                "success": true,
                "final stack": ["7465"],
                "varops cost": 3,
                "description": "LENGTHCONV + COPYING: len(BEGIN) + len(LEN) + min(2, 4-0) = 0 + 1 + 2 = 3"
            },
            {
                "name": "OP_SUBSTR - extract to end",
                "initial stack": ["626974636F696E", "03", "04"],
                "opcodes": ["OP_SUBSTR"],
                "success": true,
                "final stack": ["636F696E"],
                "varops cost": 6,
                "description": "LENGTHCONV + COPYING: len(BEGIN) + len(LEN) + min(4, 7-3) = 1 + 1 + 4 = 6"
            },
            {
                "name": "OP_SUBSTR with zero length",
                "initial stack": ["68656C6C6F", "02", ""],
                "opcodes": ["OP_SUBSTR"],
                "success": true,
                "final stack": [""],
                "varops cost": 1,
                "description": "LENGTHCONV + COPYING: len(BEGIN) + len(LEN) + min(0, 5-2) = 1 + 0 + 0 = 1"
            },
            {
                "name": "OP_SUBSTR - begin at end of string",
                "initial stack": ["616263", "03", "01"],
                "opcodes": ["OP_SUBSTR"],
                "success": true,
                "final stack": [""],
                "varops cost": 2,
                "description": "LENGTHCONV + COPYING: len(BEGIN) + len(LEN) + min(1, 3-3) = 1 + 1 + 0 = 2"
            },
            {
                "name": "OP_SUBSTR - begin beyond string length",
                "initial stack": ["6869", "0A", "05"],
                "opcodes": ["OP_SUBSTR"],
                "success": true,
                "final stack": [""],
                "varops cost": 2,
                "description": "LENGTHCONV + COPYING: len(BEGIN) + len(LEN) + min(5, max(0, 2-10)) = 1 + 1 + 0 = 2"
            },
            {
                "name": "OP_SUBSTR - length extends beyond string",
                "initial stack": ["74657374", "02", "0A"],
                "opcodes": ["OP_SUBSTR"],
                "success": true,
                "final stack": ["7374"],
                "varops cost": 4,
                "description": "LENGTHCONV + COPYING: len(BEGIN) + len(LEN) + min(10, 4-2) = 1 + 1 + 2 = 4"
            },
            {
                "name": "OP_SUBSTR with binary data",
                "initial stack": ["0102030405", "01", "03"],
                "opcodes": ["OP_SUBSTR"],
                "success": true,
                "final stack": ["020304"],
                "varops cost": 5,
                "description": "LENGTHCONV + COPYING: len(BEGIN) + len(LEN) + min(3, 5-1) = 1 + 1 + 3 = 5"
            },
            {
                "name": "OP_SUBSTR with empty string",
                "initial stack": ["", "", "01"],
                "opcodes": ["OP_SUBSTR"],
                "success": true,
                "final stack": [""],
                "varops cost": 1,
                "description": "LENGTHCONV + COPYING: len(BEGIN) + len(LEN) + min(1, 0-0) = 0 + 1 + 0 = 1"
            },
            {
                "name": "OP_SUBSTR with insufficient stack elements should fail",
                "initial stack": ["616263", "01"],
                "opcodes": ["OP_SUBSTR"],
                "success": false
            },
            {
                "name": "OP_SUBSTR with empty stack should fail",
                "initial stack": [],
                "opcodes": ["OP_SUBSTR"],
                "success": false
            }
        ]
    },
    {
        "category": "OP_INVERT tests", 
        "tests": [
            {
                "name": "OP_INVERT - basic bitwise inversion",
                "initial stack": ["FF"],
                "opcodes": ["OP_INVERT"],
                "success": true,
                "final stack": ["00"],
                "varops cost": 2,
                "description": "OTHER: len(A) * 2 = 1 * 2 = 2"
            },
            {
                "name": "OP_INVERT with all zeros",
                "initial stack": [""],
                "opcodes": ["OP_INVERT"],
                "success": true,
                "final stack": [""],
                "varops cost": 0,
                "description": "OTHER: len(A) * 2 = 0 * 2 = 0"
            },
            {
                "name": "OP_INVERT with multi-byte value",
                "initial stack": ["FF12"],
                "opcodes": ["OP_INVERT"],
                "success": true,
                "final stack": ["00ED"],
                "varops cost": 4,
                "description": "OTHER: len(A) * 2 = 2 * 2 = 4"
            },
            {
                "name": "OP_INVERT with all ones",
                "initial stack": ["FFFFFFFFFFFFFFFF"],
                "opcodes": ["OP_INVERT"],
                "success": true,
                "final stack": ["0000000000000000"],
                "varops cost": 16,
                "description": "OTHER: len(A) * 2 = 8 * 2 = 16"
            },
            {
                "name": "OP_INVERT with alternating bit pattern",
                "initial stack": ["AAAAAAAAAAAAAAAA"],
                "opcodes": ["OP_INVERT"],
                "success": true,
                "final stack": ["5555555555555555"],
                "varops cost": 16,
                "description": "OTHER: len(A) * 2 = 8 * 2 = 16"
            },
            {
                "name": "OP_INVERT with insufficient stack elements should fail",
                "initial stack": [],
                "opcodes": ["OP_INVERT"],
                "success": false
            }
        ]
    },
    {
        "category": "Binary bitwise operations",
        "tests": [
            {
                "name": "OP_AND: 0xFF & 0xF0 = 0xF0",
                "initial stack": ["FF", "F0"],
                "opcodes": ["OP_AND"],
                "success": true,
                "final stack": ["F0"],
                "varops cost": 2,
                "description": "OTHER + ZEROING: len(A) + len(B) = 1 + 1 = 2"
            },
            {
                "name": "OP_OR: 0x0F | 0xF0 = 0xFF",
                "initial stack": ["0F", "F0"],
                "opcodes": ["OP_OR"],
                "success": true,
                "final stack": ["FF"],
                "varops cost": 2,
                "description": "OTHER: min(len(A), len(B)) * 2 = min(1, 1) * 2 = 2"
            },
            {
                "name": "OP_XOR: 0xFF ^ 0x0F = 0xF0",
                "initial stack": ["FF", "0F"],
                "opcodes": ["OP_XOR"],
                "success": true,
                "final stack": ["F0"],
                "varops cost": 2,
                "description": "OTHER: min(len(A), len(B)) * 2 = min(1, 1) * 2 = 2"
            },
            {
                "name": "OP_AND with insufficient stack (empty)",
                "initial stack": [],
                "opcodes": ["OP_AND"],
                "success": false
            },
            {
                "name": "OP_OR with insufficient stack (one element)",
                "initial stack": ["FF"],
                "opcodes": ["OP_OR"],
                "success": false
            }
        ]
    },
    {
