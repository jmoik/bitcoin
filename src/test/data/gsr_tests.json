                "opcodes": ["OP_DIV"],
                "success": true,
                "final stack": ["0xff"],
                "varops cost": 46
            },
            {
                "name": "OP_DIV: 0 / 1 = 0",
                "initial stack": ["0x", "0x01"],
                "opcodes": ["OP_DIV"],
                "success": true,
                "final stack": ["0x"],
                "varops cost": 4
            },
            {
                "name": "OP_DIV: 1 / 1 = 1",
                "initial stack": ["0x01", "0x01"],
                "opcodes": ["OP_DIV"],
                "success": true,
                "final stack": ["0x01"],
                "varops cost": 22
            },
            {
                "name": "OP_DIV: 1 / 2 = 0",
                "initial stack": ["0x01", "0x02"],
                "opcodes": ["OP_DIV"],
                "success": true,
                "final stack": ["0x"],
                "varops cost": 22
            },
            {
                "name": "OP_DIV: divide by zero fails",
                "initial stack": ["0x0a", "0x"],
                "opcodes": ["OP_DIV"],
                "success": false
            },
            {
                "name": "OP_DIV: divide by explicit zero fails",
                "initial stack": ["0x0a", "0x00"],
                "opcodes": ["OP_DIV"],
                "success": false
            },
            {
                "name": "OP_DIV: empty stack fails",
                "initial stack": [],
                "opcodes": ["OP_DIV"],
                "success": false
            },
            {
                "name": "OP_DIV: one element on stack fails",
                "initial stack": ["0x0a"],
                "opcodes": ["OP_DIV"],
                "success": false
            },
            {
                "name": "OP_DIV: 4-byte / 2-byte (16777217 / 256 = 65536)",
                "initial stack": ["0x01000001", "0x0001"],
                "opcodes": ["OP_DIV"],
                "success": true,
                "final stack": ["0x000001"],
                "varops cost": 90
            },
            {
                "name": "OP_DIV: 8-byte / 1-byte",
                "initial stack": ["0x0100000000000001", "0x02"],
                "opcodes": ["OP_DIV"],
                "success": true,
                "final stack": ["0x00000000000080"],
                "varops cost": 190
            }
        ]
    },
