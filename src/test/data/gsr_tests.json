                "final stack": ["68656C"],
                "varops cost": 1,
                "description": "LENGTHCONV: len(OFFSET) = len(0x03) = 1"
            },
            {
                "name": "OP_RIGHT - basic functionality", 
                "initial stack": ["68656C6C6F", "02"],
                "opcodes": ["OP_RIGHT"],
                "success": true,
                "final stack": ["6C6F"],
                "varops cost": 3,
                "description": "LENGTHCONV + COPYING: len(OFFSET) + len(result) = 1 + 2 = 3"
            },
            {
                "name": "OP_LEFT with zero offset",
                "initial stack": ["74657374", ""],
                "opcodes": ["OP_LEFT"],
                "success": true,
                "final stack": [""],
                "varops cost": 0,
                "description": "LENGTHCONV: len(OFFSET) = len(empty) = 0"
            },
            {
                "name": "OP_RIGHT with zero offset",
                "initial stack": ["74657374", ""],
                "opcodes": ["OP_RIGHT"],
                "success": true,
                "final stack": [""],
                "varops cost": 0,
                "description": "LENGTHCONV + COPYING: len(OFFSET) + len(result) = 0 + 0 = 0"
            },
            {
                "name": "OP_LEFT with offset equal to string length",
                "initial stack": ["616263", "03"],
                "opcodes": ["OP_LEFT"],
                "success": true,
                "final stack": ["616263"],
                "varops cost": 1,
                "description": "LENGTHCONV: len(OFFSET) = 1"
            },
            {
                "name": "OP_RIGHT with offset equal to string length",
                "initial stack": ["616263", "03"],
                "opcodes": ["OP_RIGHT"],
                "success": true,
                "final stack": ["616263"],
                "varops cost": 4,
                "description": "LENGTHCONV + COPYING: len(OFFSET) + len(result) = 1 + 3 = 4"
            },
            {
                "name": "OP_LEFT with offset greater than string length",
                "initial stack": ["6869", "0A"],
                "opcodes": ["OP_LEFT"],
                "success": true,
                "final stack": ["6869"],
                "varops cost": 1,
                "description": "LENGTHCONV: len(OFFSET) = 1"
            },
            {
                "name": "OP_RIGHT with offset greater than string length",
                "initial stack": ["6869", "0A"],
                "opcodes": ["OP_RIGHT"],
                "success": true,
                "final stack": ["6869"],
                "varops cost": 3,
                "description": "LENGTHCONV + COPYING: len(OFFSET) + len(result) = 1 + 2 = 3"
            },
            {
                "name": "OP_LEFT with binary data",
                "initial stack": ["0102030405", "03"],
                "opcodes": ["OP_LEFT"],
                "success": true,
                "final stack": ["010203"],
                "varops cost": 1,
                "description": "LENGTHCONV: len(OFFSET) = 1"
            },
            {
                "name": "OP_RIGHT with binary data",
                "initial stack": ["0102030405", "02"],
                "opcodes": ["OP_RIGHT"],
                "success": true,
                "final stack": ["0405"],
                "varops cost": 3,
                "description": "LENGTHCONV + COPYING: len(OFFSET) + len(result) = 1 + 2 = 3"
            },
            {
                "name": "OP_LEFT with insufficient stack elements should fail",
