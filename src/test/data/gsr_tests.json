                "opcodes": ["OP_ROT"],
                "success": true,
                "final stack": ["0x01", "0x03", "0x04", "0x02"],
                "varops cost": 0,
                "description": ""
            },
            {
                "name": "OP_SWAP 0x01, 0x02, 0x03",
                "initial stack": ["0x01", "0x02", "0x03"],
                "opcodes": ["OP_SWAP"],
                "success": true,
                "final stack": ["0x01", "0x03", "0x02"],
                "varops cost": 0
            },
            {
                "name": "OP_SIZE 0x01, 0x02, 0x03",
                "initial stack": ["0x01", "0x02", "0x03"],
                "opcodes": ["OP_SIZE"],
                "success": true,
                "final stack": ["0x01", "0x02", "0x03", "0x01"],
                "varops cost": 1
            },
            {
                "name": "OP_DEPTH 0x01, 0x02, 0x03, 0x04, 0x05",
                "initial stack": ["0x01", "0x02", "0x03", "0x04", "0x05"],
                "opcodes": ["OP_DEPTH"],
                "success": true,
                "final stack": ["0x01", "0x02", "0x03", "0x04", "0x05", "0x05"],
                "varops cost": 1
            },
            {
                "name": "OP_IFDUP with zero value",
                "initial stack": ["0x"],
                "opcodes": ["OP_IFDUP"],
                "success": true,
                "final stack": ["0x"],
                "varops cost": 0,
                "description": "IFDUP with zero does not duplicate"
            },
            {
                "name": "OP_IFDUP with non-zero value",
                "initial stack": ["0x05"],
                "opcodes": ["OP_IFDUP"],
                "success": true,
                "final stack": ["0x05", "0x05"],
                "varops cost": 2,
                "description": "IFDUP with non-zero duplicates the value"
            },
            {
                "name": "OP_IFDUP with multi-byte value",
                "initial stack": ["0x0102"],
                "opcodes": ["OP_IFDUP"],
                "success": true,
                "final stack": ["0x0102", "0x0102"],
                "varops cost": 4,
                "description": "IFDUP duplicates multi-byte values"
            },
            {
                "name": "OP_IFDUP on empty stack",
                "initial stack": [],
                "opcodes": ["OP_IFDUP"],
                "success": false,
                "final stack": [],
                "varops cost": 0,
                "description": "IFDUP fails on empty stack"
            }
        ]
    },
