                "opcodes": ["OP_DIV"],
                "success": true,
                "final stack": ["0x03"],
                "varops cost": 22
            },
            {
                "name": "OP_DIV: 255 / 16 = 15",
                "initial stack": ["0xff", "0x10"],
                "opcodes": ["OP_DIV"],
                "success": true,
                "final stack": ["0x0f"],
                "varops cost": 22
            },
            {
                "name": "OP_DIV: 256 / 2 = 128",
                "initial stack": ["0x0001", "0x02"],
                "opcodes": ["OP_DIV"],
                "success": true,
                "final stack": ["0x80"],
                "varops cost": 42
            },
            {
                "name": "OP_DIV: 65535 / 256 = 255",
